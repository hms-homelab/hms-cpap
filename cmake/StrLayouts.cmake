# The STR layouts built into the binary (SDD-057, the STR decision).
#
# An AirSense 11 read over Bluetooth, directly or through a Mule & Miner,
# reports each day's figures but writes no STR.edf anywhere hms-cpap can read.
# To lay those days out as the card would, hms-cpap needs the STR header of
# that model: its signals, their ranges and their order. str-layouts/<product
# code>.edfh is exactly that, an STR header with no records, cut from a card
# of that model with the patient and recording fields blanked. They are
# compiled in so every build (Docker, the Pi, the macOS and Windows installers)
# has them without an install step; a file of the same name under
# <data_dir>/str-layouts/ (or HMS_CPAP_STR_LAYOUT_DIR) still wins, which is how
# a model with no built-in layout gets one before the next release.
#
# hms_str_layouts_generate(<out var>) writes one .cpp into the build tree and
# returns its path, to be added to the sources of the service and the tests.

function(hms_str_layouts_generate out)
    set(_dir "${CMAKE_SOURCE_DIR}/str-layouts")
    set(_gen "${CMAKE_BINARY_DIR}/generated/StrLayouts.cpp")
    file(GLOB _files "${_dir}/*.edfh")
    list(SORT _files)

    set(_body "// Generated by cmake/StrLayouts.cmake from str-layouts/*.edfh. Do not edit.\n")
    string(APPEND _body "#include \"services/StrLayouts.h\"\n\nnamespace hms_cpap {\nnamespace {\n\n")
    set(_table "")
    foreach(_f ${_files})
        get_filename_component(_name "${_f}" NAME_WE)
        if(NOT _name MATCHES "^[0-9]+$")
            message(FATAL_ERROR "str-layouts/${_name}.edfh: a layout is named by its product code (digits only)")
        endif()
        file(READ "${_f}" _hex HEX)
        string(LENGTH "${_hex}" _hexlen)
        math(EXPR _len "${_hexlen} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
        string(APPEND _body "const unsigned char kLayout${_name}[${_len}] = {\n${_bytes}\n};\n\n")
        string(APPEND _table "    {${_name}, kLayout${_name}, sizeof(kLayout${_name})},\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_f}")
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_dir}")

    string(APPEND _body "const BuiltinStrLayout kLayouts[] = {\n${_table}};\n\n}  // namespace\n\n")
    string(APPEND _body "const BuiltinStrLayout* builtinStrLayouts(size_t* count) {\n")
    string(APPEND _body "    *count = sizeof(kLayouts) / sizeof(kLayouts[0]);\n    return kLayouts;\n}\n\n")
    string(APPEND _body "}  // namespace hms_cpap\n")

    # Written only when it changed, so an unchanged configure does not rebuild it.
    set(_old "")
    if(EXISTS "${_gen}")
        file(READ "${_gen}" _old)
    endif()
    if(NOT _old STREQUAL _body)
        file(WRITE "${_gen}" "${_body}")
    endif()
    list(LENGTH _files _n)
    message(STATUS "STR layouts built in: ${_n} (${_gen})")
    set(${out} "${_gen}" PARENT_SCOPE)
endfunction()
