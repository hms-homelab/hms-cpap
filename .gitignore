# Logs
*.log
logs/
# ...but the Logs PAGE is source, not a log directory. The bare `logs/` rule
# above matches any directory of that name at any depth, so it silently
# swallowed the whole Angular page and the route would have imported a
# component that was never committed.
!frontend/src/app/pages/logs/

# Testing
Testing/
tests/output/
coverage/

# Docker (keep .dockerignore tracked - needed for CI builds)

# Backup files
*.backup
*.bak
*~

